@page
@model LeaveModel
@{
    ViewData["Title"] = "Leave Management";
}

<div class="leave-container">

    <div class="leave-card">

        <h2>Employee Leave Management System</h2>

        <h4 class="mb-4">Welcome, @Model.UserName</h4>

        <form method="post">

            <div class="mb-3">

                <label class="form-label">Select Leave Type</label>

                <select asp-for="LeaveType" class="form-select">

                    <option value="">-- Select Leave Type --</option>
                    <option>Casual Leave</option>
                    <option>Sick Leave</option>
                    <option>Earned Leave</option>
                    <option>Emergency Leave</option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">Select Leave Date</label>

                <input asp-for="LeaveDate" type="date" class="form-control"/>

            </div>

            <button type="submit"
                    asp-page-handler="Apply"
                    class="btn btn-success w-100">
                Apply Leave
            </button>

            @if (!string.IsNullOrEmpty(Model.Result))
            {
                <div class="alert alert-success mt-3">
                    @Html.Raw(Model.Result)
                </div>
            }

        </form>

        <form method="post" class="mt-3">

            <button type="submit"
                    asp-page-handler="Logout"
                    class="btn btn-danger w-100">
                Logout
            </button>

        </form>

    </div>

</div>

<style>

.leave-container{
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:80vh;
    background:#f5f5f5;
}

.leave-card{
    width:520px;
    background:white;
    padding:35px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
}

.leave-card h2{
    text-align:center;
    font-weight:bold;
    margin-bottom:15px;
}

.leave-card h4{
    text-align:center;
    color:#333;
}

</style>