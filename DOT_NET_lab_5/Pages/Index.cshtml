@page
@model IndexModel
@{
    ViewData["Title"] = "Employee Login";
}

<div class="login-container">

    <div class="login-card">

        <h2>Employee Leave Management System</h2>

        <form method="post">

            <div class="mb-3">
                <label class="form-label">Employee Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter your name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
            </div>

            <button type="submit" class="btn btn-dark w-100">
                Login
            </button>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <p class="text-danger mt-3 text-center">@Model.Message</p>
            }

        </form>

    </div>

</div>

<style>
.login-container{
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:80vh;
    background:#f5f5f5;
}

.login-card{
    width:420px;
    background:white;
    padding:35px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
}

.login-card h2{
    text-align:center;
    margin-bottom:25px;
    font-weight:bold;
}
</style>